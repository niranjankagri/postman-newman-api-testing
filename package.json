{
  "name": "postman-newman-api-testing",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A self-contained API testing showcase using Postman collections and Newman.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:collection": "node scripts/run-newman.js",
    "test:ci": "npm test && npm run test:collection",
    "lint:api": "npx --yes @redocly/cli@2.64.1 lint openapi.json --extends=minimal"
  },
  "devDependencies": {
    "newman": "6.2.3",
    "ajv": "6.15.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "handlebars": "4.7.10",
    "underscore": "1.13.8",
    "flatted": "3.4.4",
    "node-forge": "1.4.3"
  }
}
