{
  "info": {
    "_postman_id": "8b05da7e-70f8-4a9f-a53d-43ed727fb457",
    "name": "Commerce Demo API",
    "description": "Postman collection for the local commerce API. scripts/run-newman.js runs it twice: the main folders with customers.csv, and the Order rules folder with invalid-orders.csv.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request, so these rules can't be forgotten on a new one",
          "pm.test('TC-200 the answer is uncached JSON, in under a second', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "    pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4173"
    },
    {
      "key": "productId",
      "value": "p-100"
    },
    {
      "key": "productPriceCents",
      "value": ""
    },
    {
      "key": "lastOrderId",
      "value": ""
    },
    {
      "key": "lastOrder",
      "value": ""
    },
    {
      "key": "orderSchema",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-201 health answers ok', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.deep.equal({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Product catalog",
      "item": [
        {
          "name": "GET products and save a product ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-211 the catalog returns products', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(body.data[0]).to.have.all.keys('id', 'name', 'priceCents', 'inStock');",
                  "    // Chaining: the next request reads this value",
                  "    pm.collectionVariables.set('productId', body.data[0].id);",
                  "    pm.collectionVariables.set('productPriceCents', body.data[0].priceCents);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET product by saved ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-212 a product is found by the saved ID', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('productId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET unknown product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-213 an unknown product is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().error).to.eql('Product not found.');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Access",
      "item": [
        {
          "name": "POST order without a token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\"name\": \"Taylor Tester\", \"email\": \"taylor@example.test\"},\n  \"items\": [{\"productId\": \"p-100\", \"quantity\": 1}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-221 an order without a token is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql('Bearer token is required.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST order with an invalid token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\"name\": \"Taylor Tester\", \"email\": \"taylor@example.test\"},\n  \"items\": [{\"productId\": \"p-100\", \"quantity\": 1}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{invalidToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-222 an order with a wrong token is 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().error).to.eql('Bearer token is invalid.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET order without a token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/ord-0001",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-223 reading an order without a token is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST create order from CSV data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\"name\": \"{{customerName}}\", \"email\": \"{{email}}\"},\n  \"items\": [{\"productId\": \"{{productId}}\", \"quantity\": {{quantity}}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const quantity = Number(pm.iterationData.get('quantity'));",
                  "",
                  "pm.test('TC-231 an order is created from the CSV row', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const order = pm.response.json().data;",
                  "    pm.expect(order.status).to.eql('accepted');",
                  "    pm.expect(order.customer.name).to.eql(pm.iterationData.get('customerName'));",
                  "    pm.expect(order.customer.email).to.eql(pm.iterationData.get('email'));",
                  "    // The expected total comes from the catalog answer, not from a copied price",
                  "    pm.expect(order.totalCents).to.eql(pm.collectionVariables.get('productPriceCents') * quantity);",
                  "    pm.collectionVariables.set('lastOrderId', order.id);",
                  "    pm.collectionVariables.set('lastOrder', JSON.stringify(order));",
                  "});",
                  "",
                  "const orderSchema = pm.collectionVariables.get('orderSchema');",
                  "if (orderSchema) {",
                  "    pm.test('TC-232 the answer matches the OpenAPI order schema', function () {",
                  "        pm.response.to.have.jsonSchema(JSON.parse(orderSchema));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET read created order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/{{lastOrderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-233 the order reads back exactly as created', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data).to.eql(JSON.parse(pm.collectionVariables.get('lastOrder')));",
                  "});",
                  "",
                  "const orderSchema = pm.collectionVariables.get('orderSchema');",
                  "if (orderSchema) {",
                  "    pm.test('TC-234 the answer matches the OpenAPI order schema', function () {",
                  "        pm.response.to.have.jsonSchema(JSON.parse(orderSchema));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET unknown order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/ord-9999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-235 an unknown order is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().error).to.eql('Order not found.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST broken JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{invalid-json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-236 broken JSON is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.eql('Request body must be valid JSON.');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Order rules",
      "description": "Runs on its own with invalid-orders.csv: one request, one row per rule.",
      "item": [
        {
          "name": "POST invalid order from CSV data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\"name\": \"{{customerName}}\", \"email\": \"{{email}}\"},\n  \"items\": [{\"productId\": \"{{productId}}\", \"quantity\": {{quantity}}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rule = pm.iterationData.get('rule');",
                  "",
                  "pm.test(`TC-241 refused: ${rule}`, function () {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().error).to.eql(pm.iterationData.get('expectedError'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
